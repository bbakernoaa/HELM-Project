#ifndef HALO_VERSION_HPP
#define HALO_VERSION_HPP

/// @file version.hpp
/// @brief Compile-time version information for the HALO library.
///
/// This header is generated by CMake from version.hpp.in using the project
/// VERSION declared in CMakeLists.txt. Do not edit version.hpp directly.

/// Major version (incremented for breaking API/ABI changes).
#define HALO_VERSION_MAJOR @HALO_VERSION_MAJOR@

/// Minor version (incremented for backward-compatible feature additions).
#define HALO_VERSION_MINOR @HALO_VERSION_MINOR@

/// Patch version (incremented for backward-compatible bug fixes).
#define HALO_VERSION_PATCH @HALO_VERSION_PATCH@

/// Full version string in "MAJOR.MINOR.PATCH" format.
#define HALO_VERSION "@HALO_VERSION_MAJOR@.@HALO_VERSION_MINOR@.@HALO_VERSION_PATCH@"

#endif // HALO_VERSION_HPP
