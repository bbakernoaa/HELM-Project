@PACKAGE_INIT@

# ─── CONFConfigVersion.cmake ─────────────────────────────────────────────────
# Package version file for CONF implementing SameMajorVersion compatibility:
# a requested version is compatible when its major component equals the
# package's major component and the requested version is not newer than the
# package version.
# ─────────────────────────────────────────────────────────────────────────────

set(PACKAGE_VERSION "@PROJECT_VERSION@")

# SameMajorVersion compatibility: accept if requested major == package major
# and requested version <= package version
if(PACKAGE_FIND_VERSION_MAJOR EQUAL "@PROJECT_VERSION_MAJOR@")
    if(PACKAGE_FIND_VERSION VERSION_LESS_EQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    else()
        set(PACKAGE_VERSION_COMPATIBLE FALSE)
    endif()

    if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
else()
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
endif()
