@PACKAGE_INIT@

# ─── CONFConfig.cmake ────────────────────────────────────────────────────────
# CMake package configuration file for CONF (Configuration Parser micro-library)
#
# This file is included by find_package(CONF) and imports the HELM::CONF target.
#
# Unlike HALO — whose HALOConfig.cmake MUST re-find MPI and Kokkos because those
# are PUBLIC, transitively-propagated dependencies — CONF has NO public
# dependencies to re-discover. Its only external dependency, yaml-cpp, is linked
# PRIVATE and statically absorbed at build time, so it does not leak to
# consumers and is deliberately NOT re-found here.
# ─────────────────────────────────────────────────────────────────────────────

include(CMakeFindDependencyMacro)

# NOTE: yaml-cpp is intentionally NOT a find_dependency here. It is a PRIVATE
# implementation detail of HELM::CONF and is statically absorbed at build time.
# Re-finding it would needlessly leak the backend onto downstream consumers and
# break the guarantee that find_package(CONF) pulls in zero yaml-cpp symbols,
# headers, or transitive find calls.

# Import the exported targets (HELM::CONF, etc.)
include("${CMAKE_CURRENT_LIST_DIR}/CONFTargets.cmake")

check_required_components(CONF)
